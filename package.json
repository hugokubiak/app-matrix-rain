  },
  "license": "MIT",
  "author": "Hugo Kubiak",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "typescript-eslint": "^8.66.0"
  }
}
